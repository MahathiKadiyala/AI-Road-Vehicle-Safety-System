# ==============================================================================
# AI-Powered Road and Vehicle Safety System - Frontend Environment Configuration
# Copy this file to '.env' and adjust the values for your local environment.
# ==============================================================================

# Backend API base URL
VITE_API_BASE_URL="http://127.0.0.1:8000"

# OpenStreetMap Tile Server URL
VITE_OSM_TILE_SERVER="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"

# Default Map Center (Latitude, Longitude)
VITE_DEFAULT_MAP_LAT=12.9716
VITE_DEFAULT_MAP_LON=77.5946
VITE_DEFAULT_MAP_ZOOM=12
