# ==============================================================================
# AI-Powered Road and Vehicle Safety System - Backend Environment Configuration
# Copy this file to '.env' and adjust the values for your local environment.
# ==============================================================================

# Application Configuration
PROJECT_NAME="AI-Powered Road and Vehicle Safety System"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL + PostGIS)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
# Replace 'your_password_here' with your PostgreSQL password
DATABASE_URL="postgresql+asyncpg://postgres:your_password_here@localhost:5432/roadsafety_db"

# Storage Settings (Local file storage for development)
STORAGE_BACKEND="local"
UPLOAD_DIR="static/uploads"
MAX_UPLOAD_SIZE_MB=10

# Security (JWT configuration reserved for Phase 7 authentication)
SECRET_KEY="temporary_development_secret_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
